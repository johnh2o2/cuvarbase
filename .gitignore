# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]

# C extensions
*.so

# Distribution / packaging
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*,cover
.pytest_cache/

# Translations
*.mo
*.pot

# Django stuff:
*.log
# ... but the on-device gate/validation logs cited by the release record
# are evidence and are tracked
!analysis/**/*.log
!benchmarks/results/**/*.log

# Sphinx documentation
docs/build/

# PyBuilder
target/

# emacs backups
*~
\#*\#

.ipynb_checkpoints
.idea/*

# vim backups
*.swp

# LaTeX
*.aux
*.pdf

# misc
scripts/saved_results
.DS_Store
work/
*.png
# ... except the tracked figures (docs logo, analysis/benchmark plots)
!docs/**/*.png
!analysis/**/*.png
!benchmarks/results/**/*.png
*.gif

# RunPod configuration (contains credentials)
.runpod.env
